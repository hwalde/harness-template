{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/bootstrap.py:*)",
      "Bash(python3 tools/sync-agents.py:*)",
      "Bash(python3 tools/agent-start.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/bootstrap.py\" --quiet"
          }
        ]
      }
    ]
  }
}
